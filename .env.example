# Email settings
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
TO_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Slack webhooks
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_ASEC=
SLACK_WEBHOOK_BOANNEWS=
SLACK_WEBHOOK_CVE=
SLACK_WEBHOOK_GITHUB=
SLACK_WEBHOOK_KISA=
SLACK_WEBHOOK_MS=
SLACK_WEBHOOK_URGENT=

# CVE/NVD settings
NVD_API_KEY=
CVE_LOOKBACK_HOURS=48
MAX_NVD_ITEMS_PER_EMAIL=10
MAX_KEV_ITEMS_PER_EMAIL=10
MIN_NVD_CVSS_SCORE=7.0
CRITICAL_CVSS_SCORE=9.0

# GitHub Advisory settings
GITHUB_TOKEN=
MAX_GITHUB_ADVISORY_ITEMS_PER_EMAIL=15
GITHUB_ADVISORY_SEVERITIES=high,critical

# KISA settings
MAX_KISA_ITEMS_PER_EMAIL=10

# Microsoft security update settings
MAX_MICROSOFT_ITEMS_PER_EMAIL=20
MIN_MICROSOFT_CVSS_SCORE=7.0
CRITICAL_MICROSOFT_CVSS_SCORE=9.0

# Optional local LLM settings
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:8b

# Optional legacy boannews mailer settings
BOANNEWS_MAILER_SENDER=
BOANNEWS_MAILER_RECIPIENT=
BOANNEWS_MAILER_SMTP_SERVER=smtp.naver.com
BOANNEWS_MAILER_SMTP_PORT=465
