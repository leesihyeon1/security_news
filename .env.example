# Email settings
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
TO_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Slack webhooks
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_ASEC=
SLACK_WEBHOOK_BOANNEWS=
SLACK_WEBHOOK_CVE=
SLACK_WEBHOOK_GITHUB=
SLACK_WEBHOOK_KISA=
SLACK_WEBHOOK_MS=
SLACK_WEBHOOK_URGENT=
SLACK_WEBHOOK_REPORT=
SLACK_WEBHOOK_NEWS=

# CVE/NVD settings
NVD_API_KEY=
CVE_LOOKBACK_HOURS=48
KEV_LOOKBACK_DAYS=7
MAX_NVD_ITEMS_PER_EMAIL=10
MAX_KEV_ITEMS_PER_EMAIL=10
MIN_NVD_CVSS_SCORE=7.0
CRITICAL_CVSS_SCORE=9.0

# GitHub Advisory settings
GITHUB_TOKEN=
MAX_GITHUB_ADVISORY_ITEMS_PER_EMAIL=15
GITHUB_ADVISORY_SEVERITIES=high,critical

# KISA settings
MAX_KISA_ITEMS_PER_EMAIL=10

# Microsoft security update settings
MAX_MICROSOFT_ITEMS_PER_EMAIL=20
MIN_MICROSOFT_CVSS_SCORE=7.0
CRITICAL_MICROSOFT_CVSS_SCORE=9.0

# Triage (P1/P2/P3) EPSS thresholds
EPSS_POC_THRESHOLD=0.1
EPSS_ACTIVE_THRESHOLD=0.5

# News importance filter (0-100). Articles below this score are stored in
# events.jsonl (daily report) without immediate email/Slack alerts.
# P1/P2 triage always alerts regardless of score. Default 45 keeps a maxed-out
# Moderate band (64) from reliability-C sources (x0.75 = 48) above the bar.
NEWS_ALERT_MIN_SCORE=45

# Cross-source clustering window (hours). Articles matching a recent event
# (shared CVEs or similar title) get a corroboration bonus; if the story was
# already alerted, the duplicate alert is suppressed unless severity escalated.
CLUSTER_WINDOW_HOURS=72

# Slack feedback poller (optional): reads reactions on alert messages as
# useful/noise labels (see slack_feedback_poller.py for the emoji sets).
# Bot needs channels:history + reactions:read scopes and must be invited
# to the channels.
SLACK_BOT_TOKEN=
SLACK_FEEDBACK_CHANNELS=

# Click-tracking feedback (optional, see click-tracker/README.md): report
# links get rewritten to go through a small Vercel redirect function that
# logs the click to Upstash Redis, and scripts/click_feedback_puller.py
# pulls that log into feedback.jsonl as useful labels. Leave blank to skip
# entirely — tracking_url() then returns the original URL unchanged.
CLICK_TRACK_BASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LLM provider: "nvidia" (NVIDIA NIM API, falls back to Ollama on failure)
# or "ollama" (local only, default)
LLM_PROVIDER=ollama

# NVIDIA NIM API (build.nvidia.com) — free tier, ~40 requests/min.
# Get an API key (nvapi-...) at https://build.nvidia.com after signing up.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Optional local LLM settings (used when LLM_PROVIDER=ollama or as fallback)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:8b

# Optional legacy boannews mailer settings
BOANNEWS_MAILER_SENDER=
BOANNEWS_MAILER_RECIPIENT=
BOANNEWS_MAILER_SMTP_SERVER=smtp.naver.com
BOANNEWS_MAILER_SMTP_PORT=465
